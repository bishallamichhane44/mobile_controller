<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow ALL cleartext traffic - no restrictions -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
    
    <!-- Explicitly allow all IP ranges -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow all possible domains -->
        <domain includeSubdomains="true">*</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">0.0.0.0</domain>
        
        <!-- Allow all private network ranges -->
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        
        <!-- Allow specific IP that was failing -->
        <domain includeSubdomains="true">192.168.1.67</domain>
        
        <!-- Allow entire 192.168.1.x range -->
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.1.2</domain>
        <domain includeSubdomains="true">192.168.1.3</domain>
        <domain includeSubdomains="true">192.168.1.4</domain>
        <domain includeSubdomains="true">192.168.1.5</domain>
        <domain includeSubdomains="true">192.168.1.6</domain>
        <domain includeSubdomains="true">192.168.1.7</domain>
        <domain includeSubdomains="true">192.168.1.8</domain>
        <domain includeSubdomains="true">192.168.1.9</domain>
        <domain includeSubdomains="true">192.168.1.10</domain>
        <domain includeSubdomains="true">192.168.1.20</domain>
        <domain includeSubdomains="true">192.168.1.30</domain>
        <domain includeSubdomains="true">192.168.1.40</domain>
        <domain includeSubdomains="true">192.168.1.50</domain>
        <domain includeSubdomains="true">192.168.1.60</domain>
        <domain includeSubdomains="true">192.168.1.67</domain>
        <domain includeSubdomains="true">192.168.1.70</domain>
        <domain includeSubdomains="true">192.168.1.80</domain>
        <domain includeSubdomains="true">192.168.1.90</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
        <domain includeSubdomains="true">192.168.1.200</domain>
        <domain includeSubdomains="true">192.168.1.254</domain>
    </domain-config>
</network-security-config>
